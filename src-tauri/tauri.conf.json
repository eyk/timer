{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eyk Timer",
  "version": "1.0.1",
  "identifier": "io.github.eyk.timer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Timer",
        "width": 360,
        "height": 244,
        "center": true,
        "visible": false,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "fullscreen": false,
        "decorations": true,
        "theme": null
      }
    ],
    "security": {
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420",
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Walter Seethaler",
    "copyright": "Copyright © 2026 Walter Seethaler",
    "shortDescription": "Type minutes. Press Enter. Done.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "German"
        ],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../store/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    }
  }
}
