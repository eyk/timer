{
  "identifier": "io.github.eyk.timer.e2e",
  "app": {
    "security": {
      "capabilities": [
        {
          "identifier": "e2e",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten",
            "core:window:allow-is-visible",
            "core:window:allow-current-monitor",
            "core:app:allow-identifier",
            "core:window:allow-set-theme"
          ]
        }
      ]
    }
  }
}
